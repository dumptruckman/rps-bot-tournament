    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise ReleaseError("the C# release inputs are incomplete") from error
    if set(selection) != {
        "policy", "dotnet_release", "sdk_version", "runtime_version",
        "csharp_version", "rationale", "selected_on", "upstream_release",
    } or selection["policy"] != "latest-upstream-supported-lts":
        raise ReleaseError("the C# runtime selection rationale is incomplete")
    if runtime_config.get("runtimeOptions", {}).get("framework") != {
        "name": "Microsoft.NETCore.App",
        "version": selection["runtime_version"],
    }:
        raise ReleaseError("the C# runtime configuration is not pinned")
    for platform in ("linux/amd64", "linux/arm64"):
        try:
            selected = definition["platforms"][platform]
        except (KeyError, TypeError) as error:
            raise ReleaseError("the C# runtime is missing " + platform) from error
        if set(selected) != {"build_toolchain", "execution_runtime"}:
            raise ReleaseError("the C# runtime coordinates are incomplete")
        if selection["sdk_version"] not in selected["build_toolchain"]["version"]:
            raise ReleaseError("the C# SDK coordinate is incomplete")
        if selection["runtime_version"] not in selected["execution_runtime"]["version"]:
            raise ReleaseError("the C# runtime coordinate is incomplete")
    _verify_networkless_recipe_policy(
        catalog, "csharp", "C#", ("dotnet restore", "nuget", "curl ", "wget ")
    )


