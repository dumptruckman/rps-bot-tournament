def _verify_stable_runtime_policy(
    catalog: Any,
    environment_name: str,
    version_field: str,
    *,
    policy: str = "latest-upstream-supported-stable",
    additional_selection_fields: Sequence[str] = (),
) -> None:
    environment = catalog.environment(environment_name)
    shown_name = _language_display_name(environment_name)
    try:
        definition = json.loads(environment.assets["base_runtime"].content)
        selection = definition["selection"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise ReleaseError(
            "the " + shown_name + " runtime must record its stable-release selection"
        ) from error
    expected_selection_fields = {
        "policy",
        version_field,
        "rationale",
        "selected_on",
        "upstream_release",
    } | set(additional_selection_fields)
    if not isinstance(selection, dict) or set(selection) != expected_selection_fields:
        raise ReleaseError("the " + shown_name + " runtime selection rationale is incomplete")
    if selection["policy"] != policy:
        raise ReleaseError(
            "the " + shown_name + " runtime must use selection policy " + policy
        )
    for field in expected_selection_fields - {"policy"}:
        if not isinstance(selection[field], str) or not selection[field]:
            raise ReleaseError(
                "the " + shown_name + " runtime selection rationale is incomplete"
            )
    for platform in ("linux/amd64", "linux/arm64"):
        try:
            selected = definition["platforms"][platform]
        except (KeyError, TypeError) as error:
            raise ReleaseError(
                "the " + shown_name + " runtime is missing " + platform
            ) from error
        if not isinstance(selected, dict) or set(selected) != {
            "build_toolchain",
            "execution_runtime",
        }:
            raise ReleaseError(
                "the " + shown_name
                + " runtime must publish explicit build and execution coordinates for "
                + platform
            )
        for role in ("build_toolchain", "execution_runtime"):
            image = selected[role]
            if not isinstance(image, dict) or set(image) != {"image", "version"}:
                raise ReleaseError(
                    "the " + shown_name + " " + role + " coordinate is incomplete"
                )
            if selection[version_field] not in image["version"]:
                raise ReleaseError(
                    "the " + shown_name + " " + role
                    + " version does not identify the selected release"
                )


