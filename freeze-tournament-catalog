def _verify_clojure_release_policy(catalog: Any) -> None:
    environment = catalog.environment("clojure")
    try:
        definition = json.loads(environment.assets["base_runtime"].content)
        selection = definition["selection"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise ReleaseError("the Clojure release inputs are incomplete") from error
    if set(selection) != {
        "policy", "clojure_version", "clojure_cli_version", "java_version",
        "java_lts_release", "rationale", "selected_on", "upstream_release",
        "java_support",
    } or selection["policy"] != (
        "latest-upstream-supported-stable-with-latest-compatible-java-lts"
    ):
        raise ReleaseError("the Clojure and Java runtime selection is incomplete")
    for platform in ("linux/amd64", "linux/arm64"):
        try:
            selected = definition["platforms"][platform]
        except (KeyError, TypeError) as error:
            raise ReleaseError("the Clojure runtime is missing " + platform) from error
        if set(selected) != {"build_toolchain", "execution_runtime"}:
            raise ReleaseError("the Clojure runtime coordinates are incomplete")
        if not all(
            value in selected["build_toolchain"]["version"]
            for value in (
                selection["clojure_version"],
                selection["clojure_cli_version"],
                selection["java_version"],
            )
        ):
            raise ReleaseError("the Clojure build-toolchain coordinate is incomplete")
        if not all(
            value in selected["execution_runtime"]["version"]
            for value in (selection["clojure_version"], selection["java_version"])
        ):
            raise ReleaseError("the Clojure execution-runtime coordinate is incomplete")
    dependency_lines = [
        line.split()
        for line in environment.assets["dependency_definition"].content.decode().splitlines()
        if line.strip()
    ]
    if len(dependency_lines) != 3 or any(
        len(line) != 2 or not re.fullmatch(r"[0-9a-f]{64}", line[0])
        for line in dependency_lines
    ):
        raise ReleaseError("the approved Clojure runtime jars are not exactly locked")
    _verify_networkless_recipe_policy(
        catalog,
        "clojure",
        "Clojure",
        ("clojure -p", "clojure -x", "mvn ", "lein ", "clojars", "curl ", "wget "),
    )


def _verify_typescript_release_policy(catalog: Any) -> None:
    environment = catalog.environment("typescript")
    try:
        definition = json.loads(environment.assets["base_runtime"].content)
        selection = definition["selection"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise ReleaseError(
            "the TypeScript runtime must record its LTS and compiler selection"
        ) from error
    if set(selection) != {
        "policy", "node_version", "node_lts_release", "typescript_version",
        "rationale", "selected_on", "upstream_node_release",
        "upstream_typescript_release",
    } or selection["policy"] != "latest-upstream-supported-lts":
        raise ReleaseError("the TypeScript runtime selection rationale is incomplete")
    dependency = environment.assets["dependency_definition"]
    for platform in ("linux/amd64", "linux/arm64"):
        try:
            selected = definition["platforms"][platform]
            compiler = selected["build_toolchain"]["typescript"]
        except (KeyError, TypeError) as error:
            raise ReleaseError(
                "the TypeScript runtime is missing immutable inputs for " + platform
            ) from error
        if set(selected) != {"build_toolchain", "execution_runtime"}:
            raise ReleaseError("the TypeScript runtime coordinates are incomplete")
        if set(selected["build_toolchain"]) != {"image", "typescript", "version"}:
            raise ReleaseError("the TypeScript build toolchain coordinate is incomplete")
        if set(selected["execution_runtime"]) != {"image", "version"}:
            raise ReleaseError("the TypeScript execution runtime coordinate is incomplete")
        if (
            compiler.get("version") != selection["typescript_version"]
            or compiler.get("sha256") != dependency.digest
            or compiler.get("package") != dependency.path.name
            or selection["node_version"] not in selected["build_toolchain"]["version"]
            or selection["node_version"] not in selected["execution_runtime"]["version"]
        ):
            raise ReleaseError("the TypeScript compiler or Node.js identity is incomplete")
    _verify_networkless_recipe_policy(
        catalog,
        "typescript",
        "TypeScript",
        ("npm install", "npm ci", "npx ", "curl ", "wget "),
    )


