def _verify_csharp_release_policy(catalog: Any) -> None:
    environment = catalog.environment("csharp")
    try:
        definition = json.loads(environment.assets["base_runtime"].content)
        selection = definition["selection"]
        runtime_config = json.loads(
            environment.assets["dependency_definition"].content
